; Sucre 3D — la ciudad virtual (web en la PC y app Android). Ver ciudad3d/LEEME.md.
config_version=5

[application]

config/name="MiCiudad Sucre"
config/description="La Ciudad Blanca, en 3D: recorre a pie el centro histórico de Sucre."
run/main_scene="res://escenas/principal.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icono.png"

[audio]

; la web se sirve por http (sin contexto seguro): AudioWorklet no existe ahí y el motor se caía al iniciar
; ("Cannot read properties of undefined (reading 'addModule')"). ScriptProcessor funciona con y sin https.
driver/driver.web="ScriptProcessor"

[autoload]

Datos="*res://scripts/datos.gd"
Hora="*res://scripts/hora.gd"
Guardado="*res://scripts/guardado.gd"
Interaccion="*res://scripts/interaccion.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[input_devices]

pointing/emulate_touch_from_mouse=false

[physics]

3d/physics_engine="Jolt Physics"
3d/default_gravity=24.0
common/physics_ticks_per_second=60
common/physics_ticks_per_second.web=30
common/max_physics_steps_per_frame=4
common/physics_interpolation=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.web="gl_compatibility"
rendering_device/fallback_to_opengl3=true
rendering_device/fallback_to_vulkan=true
textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=0
environment/defaults/default_clear_color=Color(0.737, 0.827, 0.918, 1)
scaling_3d/mode=0
